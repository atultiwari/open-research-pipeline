{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journals.schema.json",
  "title": "Journal shortlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["journals", "excluded"],
  "properties": {
    "researched": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "journals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "publisher", "areas", "free_route", "url", "last_checked"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "publisher": {"type": "string"},
          "areas": {"type": "array", "minItems": 1,
                    "items": {"enum": ["computational-pathology", "gastro-hepatology", "clinical-data-llm", "healthcare-cybersecurity"]}},
          "free_route": {"type": "string"},
          "first_decision": {"type": "string"},
          "acceptance_to_online": {"type": "string"},
          "fits": {"type": "string"},
          "url": {"type": "string", "pattern": "^(https?://\\S+|verify)$"},
          "indexing": {"type": "string"},
          "verify_flags": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "last_checked": {"type": "string"}
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "reason"],
                "properties": {"name": {"type": "string"}, "reason": {"type": "string"}, "source": {"type": "string"}}}
    }
  }
}
