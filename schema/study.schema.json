{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study.schema.json",
  "title": "Study opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "area", "tags", "status", "status_history", "source", "datasets",
               "study_type", "reporting_guideline", "novelty_delta", "compute", "est_weeks",
               "scores", "risks", "access_actions", "candidate_journals", "added_at", "added_by"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "status": {"enum": ["new", "approved", "protocol", "analysis", "drafting", "preprint",
                        "submitted", "published", "parked", "rejected"]},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "urlOrVerify": {"type": "string", "pattern": "^(https?://\\S+|verify)$"}
  },
  "properties": {
    "id": {"$ref": "#/$defs/slug"},
    "legacy_id": {"type": "string"},
    "title": {"type": "string", "minLength": 10},
    "area": {"enum": ["computational-pathology", "gastro-hepatology", "clinical-data-llm", "healthcare-cybersecurity"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"$ref": "#/$defs/status"},
    "status_history": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["status", "date"],
                "properties": {"status": {"$ref": "#/$defs/status"}, "date": {"$ref": "#/$defs/date"},
                               "note": {"type": "string"}}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["type", "title", "url"],
      "properties": {
        "type": {"enum": ["preprint", "journal", "conference", "code", "dataset", "model"]},
        "title": {"type": "string"},
        "authors": {"type": "string"},
        "venue": {"type": "string"},
        "date": {"type": "string"},
        "url": {"$ref": "#/$defs/urlOrVerify"},
        "doi": {"type": "string", "pattern": "^(10\\.\\d{4,9}/\\S+|verify)$"},
        "arxiv_id": {"type": "string", "pattern": "^(\\d{4}\\.\\d{4,5}(v\\d+)?|verify)$"},
        "code_url": {"$ref": "#/$defs/urlOrVerify"},
        "code_licence": {"type": "string"},
        "code_note": {"type": "string"}
      }
    },
    "datasets": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "role"],
                "properties": {"id": {"$ref": "#/$defs/slug"},
                               "role": {"enum": ["development", "external-validation", "benchmark"]}}}
    },
    "study_type": {"type": "string"},
    "reporting_guideline": {"type": "string"},
    "novelty_delta": {"type": "string", "minLength": 20},
    "compute": {
      "type": "object", "additionalProperties": false, "required": ["tier", "estimate"],
      "properties": {"tier": {"enum": ["laptop", "colab", "runpod", "api"]}, "estimate": {"type": "string"}}
    },
    "est_weeks": {"type": "integer", "minimum": 1, "maximum": 104},
    "scores": {
      "type": "object", "additionalProperties": false, "required": ["feasibility", "novelty", "fit"],
      "properties": {"feasibility": {"$ref": "#/$defs/score"}, "novelty": {"$ref": "#/$defs/score"},
                     "fit": {"oneOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]}}
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "access_actions": {"type": "array", "items": {"type": "string"}},
    "candidate_journals": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "links": {
      "type": "object", "additionalProperties": false,
      "properties": {"protocol": {"type": "string"}, "repo": {"type": "string"},
                     "preprint": {"type": "string"}, "journal_submission": {"type": "string"}}
    },
    "added_at": {"type": "string"},
    "added_by": {"enum": ["atul", "scout", "claude-code"]},
    "run_id": {"type": "string"},
    "last_reviewed": {"type": "string"}
  }
}
